<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <!--
      Capacitor's template sets android:background="@drawable/splash" here, which
      Android 12+ ignores: from then on the system draws the splash itself and
      only reads the windowSplashScreen* attributes. targetSdk is 36, so on every
      device this app supports the template line did nothing and the launch fell
      back to a bare system default.

      The splash icon is its own drawable, not the launcher foreground. That
      canvas is 288dp and the system masks it to a circle of the inner 192dp,
      so 192/288 is a diameter and a square mark has to be sized by its
      diagonal or its corners are cut.

      It is a vector rather than a bitmap, generated from the logo SVG by
      scripts/build-splash-vector.py, which lets the mark assemble piece by
      piece and sidesteps density entirely: the old bitmap route pointed at the
      192px launcher plate and upscaled it 4.2x at this device 450dpi.

      The badge gradient lives inside the vector, so the animation did not cost
      the colour. One badge serves both themes, as the launcher icon does; only
      windowSplashScreenBackground changes, via values-night.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_anim</item>
        <item name="windowSplashScreenAnimationDuration">510</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>