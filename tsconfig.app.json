{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    // shared/llmTasks.js is plain JS so a Vercel function can read it too.
    "allowJs": true,
    "checkJs": false,
    // src/data/starterDeck.json is imported as data by src/lib/starterDeck.ts.
    "resolveJsonModule": true
  },
  "include": ["src", "shared"]
}
